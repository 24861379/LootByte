<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen producto -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:contentDescription="@string/todo"
            android:scaleType="centerCrop"
            android:src="@drawable/producto_1" />

        <!-- Contenido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hyperx_cloud_iii_"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <!-- Precio -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_349_900__"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#A855F7"
                android:layout_marginTop="8dp" />

            <!-- Descripción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/descripci_n_"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/los_hyperx_cloud_iii_ofrecen_sonido_envolvente_de_alta_calidad_micr_fono_desmontable_con_cancelaci_n_de_ruido_y_almohadillas_memory_foam_para_m_xima_comodidad_durante_largas_sesiones_gaming_compatibles_con_pc_playstation_y_xbox"
                android:textSize="16sp"
                android:textColor="#555555"
                android:layout_marginTop="8dp" />

            <!-- Reseñas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rese_as"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#F5F5F5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Estrellas"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/excelente_calidad_de_sonido_y_muy_c_modos_para_jugar_durante_horas"
                        android:textSize="15sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/andr_s_g"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Botón carrito -->
            <Button
                android:id="@+id/btnCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/agregar_al_carrito_"
                android:textColor="#FFFFFF"
                android:backgroundTint="#A855F7"
                android:layout_marginTop="32dp" />

            <!-- Botón comprar -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/comprar_ahora_"
                android:textColor="#A855F7"
                android:backgroundTint="#E9D5FF"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>